# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Commit this to GitHub)
# Copy this file to .env and fill in your actual private credentials.
# DO NOT commit the .env file with real secrets to GitHub!
# ==============================================================================

# LLM / GenAI Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Server Network Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Optional: Camera Device Index (0 for default webcam, 1 for external, or stream URL)
CAMERA_INDEX=0
